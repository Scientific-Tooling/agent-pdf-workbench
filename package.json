{
  "name": "agent-pdf-workbench-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "vite build",
    "check": "npm run check:frontend",
    "check:all": "npm run check:frontend && npm run check:backend",
    "check:backend": "npm run test:python",
    "check:frontend": "npm run typecheck && npm run lint && npm run test:unit && npm run build:frontend",
    "dev": "npm run dev:frontend",
    "dev:frontend": "vite",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,css,html}\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"frontend/**/*.{ts,tsx,css,html}\" \"*.{json,ts}\"",
    "lint": "eslint \"frontend/src/**/*.{ts,tsx}\" \"vite.config.ts\" \"vitest.config.ts\" --max-warnings 0",
    "preview": "npm run preview:frontend",
    "preview:frontend": "vite preview --host 127.0.0.1 --port 4173",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:python",
    "test:e2e": "playwright test",
    "test:python": "PYTHONPATH=src python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:python:unit": "PYTHONPATH=src python3 -m unittest discover -s tests/unit -p 'test_*.py' -v",
    "test:python:integration": "PYTHONPATH=src python3 -m unittest discover -s tests/integration -p 'test_*.py' -v",
    "test:smoke": "PYTHONPATH=src python3 -m unittest tests.integration.test_viewer_server.ViewerServerApiE2ETest -v",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:watch": "npm run test:unit:watch",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:all"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@playwright/test": "^1.54.2",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@eslint/js": "^9.23.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "vitest": "^3.0.9"
  }
}
