{
  "name": "agent-pdf-workbench-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "npm run build:frontend",
    "build:frontend": "vite build",
    "check": "npm run check:frontend",
    "check:all": "npm run check:frontend && npm run check:backend",
    "check:backend": "npm run lint:python && npm run test:python",
    "check:frontend": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run build:frontend",
    "dev": "npm run dev:frontend",
    "dev:frontend": "vite",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,css,html}\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"frontend/**/*.{ts,tsx,css,html}\" \"*.{json,ts}\"",
    "lint": "eslint \"frontend/src/**/*.{ts,tsx}\" \"vite.config.ts\" \"vitest.config.ts\" --max-warnings 0",
    "lint:python": "python3 -m ruff check src tests",
    "preview": "npm run preview:frontend",
    "preview:frontend": "vite preview --host 127.0.0.1 --port 4173",
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:python",
    "test:e2e": "playwright test",
    "test:python": "PYTHONPATH=src python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:python:integration": "PYTHONPATH=src python3 -m unittest discover -s tests/integration -p 'test_*.py' -v",
    "test:python:unit": "PYTHONPATH=src python3 -m unittest discover -s tests/unit -p 'test_*.py' -v",
    "test:smoke": "PYTHONPATH=src python3 -m unittest tests.integration.test_viewer_server.ViewerServerApiE2ETest -v",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:watch": "npm run test:unit:watch",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:all && npm run test:e2e",
    "verify:without-e2e": "npm run check:all"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
