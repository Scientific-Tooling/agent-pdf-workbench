{
  "name": "agent-pdf-workbench-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint \"frontend/src/**/*.ts\" \"vite.config.ts\" \"vitest.config.ts\" --max-warnings 0",
    "format": "prettier --write \"frontend/**/*.{ts,css,html}\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"frontend/**/*.{ts,css,html}\" \"*.{json,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@eslint/js": "^9.23.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "vitest": "^3.0.9"
  }
}
